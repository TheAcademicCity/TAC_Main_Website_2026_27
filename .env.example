# =============================================================================
# Zoho CRM — Bangalore (default for Preferred Campus = Bangalore)
# =============================================================================
# Legacy aliases still work: ZOHO_ZAPI_KEY / ZOHO_FUNCTION_URL / ZOHO_OAUTH_TOKEN
# Put REAL keys only in `.env.local` (gitignored) — never here.
ZOHO_BANGALORE_ZAPI_KEY=your_bangalore_zapikey_here
ZOHO_BANGALORE_FUNCTION_URL=https://www.zohoapis.in/crm/v7/functions/newwebsitecreatelead/actions/execute
# Optional — used only if ZAPI key is empty (auth_type=oauth)
ZOHO_BANGALORE_OAUTH_TOKEN=

# =============================================================================
# Zoho CRM — Indore (used when Preferred Campus = Indore)
# =============================================================================
ZOHO_INDORE_ZAPI_KEY=your_indore_zapikey_here
ZOHO_INDORE_FUNCTION_URL=https://www.zohoapis.in/crm/v7/functions/tac_website/actions/execute
# Optional — used only if ZAPI key is empty (auth_type=oauth)
ZOHO_INDORE_OAUTH_TOKEN=

# Legacy single-org keys (fallback for Bangalore if campus-specific keys are unset)
# ZOHO_ZAPI_KEY=
# ZOHO_FUNCTION_URL=
# ZOHO_OAUTH_TOKEN=
